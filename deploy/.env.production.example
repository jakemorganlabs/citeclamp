# citeclamp production environment.
# Copy this file to deploy/.env.production, chmod 600, and fill in the value. The repo tracks only this example.
# The service binds 127.0.0.1 and reads its port from config/server.json. It calls no model, so no model key is needed.

# Shared secret for the /seal HMAC-SHA256 signature. Generate with: openssl rand -hex 32
HMAC_SECRET=__REPLACE_ME__
